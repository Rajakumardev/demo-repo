{
  "name": "expense-manager-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express.js REST API for the Expense Manager",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "cross-env NODE_ENV=test node --test --experimental-test-module-mocks",
    "test:watch": "cross-env NODE_ENV=test node --test --watch --experimental-test-module-mocks",
    "test:coverage": "cross-env NODE_ENV=test c8 --all --check-coverage --statements 85 --branches 85 --functions 85 --lines 85 --reporter=text-summary --include='src/**' --exclude='src/**/*.test.js' --exclude='src/server.js' node --test --experimental-test-module-mocks"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "supertest": "^7.3.1"
  }
}
