# =============================================================================
# Expense Manager — example environment file
# Copy to `.env` and adjust the values for your environment:
#     cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# -----------------------------------------------------------------------------
# PostgreSQL
# When running through docker-compose the host is the service name `db`.
# When running the backend directly on the host use `localhost`.
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=expense_manager
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense_secret

# Optional single connection string. If set it takes precedence over the
# individual POSTGRES_* variables above.
# DATABASE_URL=postgres://expense:expense_secret@db:5432/expense_manager

# -----------------------------------------------------------------------------
# JWT authentication
# Generate strong secrets in production, e.g. `openssl rand -hex 48`.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS — comma separated list of allowed origins for the browser client.
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Frontend (Vite) — baked into the client bundle at build time.
# Optional: the client defaults to the relative `/api`, which works with the
# Vite dev proxy and the nginx reverse proxy. Set this only to point the client
# at a different API origin.
# -----------------------------------------------------------------------------
VITE_API_URL=/api
