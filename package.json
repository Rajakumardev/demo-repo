{
  "name": "expense-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Expense manager monorepo — git hooks, linting and coverage verification",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm --prefix backend run test && npm --prefix frontend run test",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test",
    "coverage": "npm run coverage:backend && npm run coverage:frontend",
    "coverage:backend": "npm --prefix backend run test:coverage",
    "coverage:frontend": "npm --prefix frontend run test:coverage",
    "verify": "npm run lint && npm run coverage"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1"
  }
}
